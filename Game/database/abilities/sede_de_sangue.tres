[ext_resource type="Script" path="res://resources/abilities/ability_resource.gd" id="1"]

[resource]
script = ExtResource("1")
ability_name = "Sede de Sangue"
category = "Habilidade Avançada"
tier = 5
trigger_description = "Realização de ataque que causa dano diretamente ao HP de um inimigo."
target_description = "Mesmo alvo do ataque e próprio pelotão."
effect_description = "Causa dano adicional diretamente ao HP do mesmo alvo e recupera HP do próprio pelotão."
values_description = "Dano: 10 direto ao HP (adicional)\nRecuperação: 10 HP"
notes = "Versão de Tier V com os mesmos valores de Dreno de Vida (Tier I). Criada para corrigir a referência quebrada 'Drenar Vida' (Esqueleto Guerreiro, Abominação Putrefata)."
