[ext_resource type="Script" path="res://resources/abilities/ability_resource.gd" id="1"]

[resource]
script = ExtResource("1")
ability_name = "Atordoamento"
category = "Habilidade Avançada"
tier = 5
trigger_description = "Realização de um ataque (respeitando tempo de recarga)."
target_description = "Alvo do ataque."
