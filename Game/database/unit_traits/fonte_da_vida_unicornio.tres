[resource]
script = ExtResource("1")
trait_name = "Fonte da Vida"
base_effect_description = "Sempre que este pelotão recuperar HP, restaura 10 HP aos pelotões imediatamente à esquerda e à direita, respeitando o HP máximo de cada unidade."
